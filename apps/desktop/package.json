{
  "name": "@margin/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Margin desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build.mjs",
    "build": "node scripts/build.mjs && electron-builder --mac --dir --config electron-builder.yml",
    "package": "node scripts/build.mjs && electron-builder --mac --config electron-builder.yml",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:packaged": "node scripts/verify-packaged.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@margin/core": "workspace:*",
    "@types/node": "22.20.5",
    "chokidar": "6.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
