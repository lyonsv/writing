{
  "name": "margin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @margin/desktop dev",
    "dev:web": "pnpm --filter @margin/app web",
    "dev:server": "pnpm --filter @margin/server dev",
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p e2e",
    "test": "vitest run",
    "build:web": "pnpm --filter @margin/app export:web",
    "build:desktop": "pnpm build:web && pnpm --filter @margin/desktop build",
    "test:e2e": "playwright test",
    "verify:packaged": "pnpm --filter @margin/desktop verify:packaged",
    "brand:build": "node scripts/brand/build.mjs",
    "brand:check": "node scripts/brand/build.mjs --check",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "docs:screenshots": "node scripts/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "opentype.js": "2.0.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
